<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TaskyAndroid.Convertors"
             x:Class="TaskyAndroid.TasksPage"
             Title="TasksPage">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8036" Offset="0.1"/>
            <GradientStop Color="#e67d40" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:UsernameAndTypeConvert x:Key="UserConvert"/>
            <local:CategoryConvert x:Key="CategoryConvert"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="20"
          x:Name="MainGrid">

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,20">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  RowSpacing="0">

                <!-- Logo -->
                <HorizontalStackLayout Grid.Column="0"
                                      Spacing="8">
                    <Image Source="taskylogo.png"
                           HeightRequest="50"
                           WidthRequest="70"/>
                </HorizontalStackLayout>

                <!-- My Shift Button -->
                <Button Grid.Column="1"
                        x:Name="MyShiftButton"
                        Text="My Shift"
                        Clicked="NavigateToUserList"
                        Style="{StaticResource HeaderButtonStyle}"
                        BackgroundColor="{StaticResource SecondaryColor}"
                        TextColor="{StaticResource PrimaryColor}"
                        FontFamily="OpenSansSemiBold"
                        Margin="10,0"/>

                <!-- Logout Button -->
                <Button Grid.Column="2"
                        Text="Clock-Out"
                        Clicked="ClockoutClicked"
                        Style="{StaticResource HeaderButtonStyle}"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"/>
            </Grid>
        </Border>

        <!-- User Info Card -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,20"
                x:Name="UserInfoBorder">
            <Grid ColumnDefinitions="Auto,*">
                <!-- User Details -->
                <VerticalStackLayout Grid.Column="1"
                                    VerticalOptions="Center">
                    <Label Text="{Binding .,Converter={StaticResource UserConvert}}"
                           FontFamily="OpenSansRegular"
                           FontSize="20"
                           TextColor="{StaticResource PrimaryColor}"/>
                    <Label Text="{Binding email}"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           TextColor="{StaticResource PrimaryColor}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}" 
                x:Name="TaskBoard">
            <ScrollView>
                <VerticalStackLayout Padding="10" Spacing="15">
                    <Label Text="My Tasks" 
                           FontSize="24" 
                           TextColor="#212121" 
                           FontFamily="OpenSansBold" 
                           Margin="5,0,0,10"/>

                    <CollectionView SelectionMode="None" x:Name="TaskList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <toolkit:Expander Margin="0,0,0,15">
                                    <toolkit:Expander.Header>
                                        <Frame BorderColor="{StaticResource TaskCardBorder}" 
                                               CornerRadius="12" 
                                               Padding="15" 
                                               HasShadow="True" 
                                               BackgroundColor="{StaticResource TaskCardBackground}">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Ellipse Style="{StaticResource StatusIndicatorStyle}" 
                                                         Grid.Column="0"/>

                                                <Label Text="{Binding subject}" 
                                                       Style="{StaticResource TaskSubjectStyle}"
                                                       Grid.Column="1"/>
                                            </Grid>
                                        </Frame>
                                    </toolkit:Expander.Header>
                                    <toolkit:Expander.Content>
                                        <Frame BorderColor="{StaticResource TaskCardBorder}" 
                                               CornerRadius="12" 
                                               Padding="20" 
                                               BackgroundColor="#FAFAFA"
                                               Margin="5,0,5,5">
                                            <VerticalStackLayout Spacing="12">
                                                <Frame Style="{StaticResource CategoryTagStyle}">
                                                    <Label Text="{Binding _category, Converter={StaticResource CategoryConvert}}" 
                                                          Style="{StaticResource CategoryTextStyle}"/>
                                                </Frame>

                                                <BoxView HeightRequest="1" 
                                                         BackgroundColor="#EEEEEE"
                                                         Margin="0,5"/>

                                                <Label Text="{Binding description}" 
                                                       Style="{StaticResource TaskDescriptionStyle}"/>

                                                <Button Text="Submit Task"
                                                        BindingContext="{Binding .}"
                                                        Style="{StaticResource SubmitButtonStyle}"
                                                        Clicked="NvigateToSubmitClicked">
                                                    <Button.Shadow>
                                                        <Shadow Brush="#40000000"
                                                                Offset="0,3"
                                                                Radius="5" />
                                                    </Button.Shadow>
                                                </Button>
                                            </VerticalStackLayout>
                                        </Frame>
                                    </toolkit:Expander.Content>
                                </toolkit:Expander>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="No tasks available" 
                                       FontSize="18" 
                                       TextColor="#757575" 
                                       HorizontalOptions="Center"/>
                                <Label Text="All caught up!" 
                                       FontSize="14" 
                                       TextColor="#9E9E9E" 
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>