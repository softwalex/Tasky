<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskyAndroid.TasksPage"
             Title="TasksPage">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">

            <!-- Expanding Block 1 -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Frame BorderColor="#BDBDBD" CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="White">
                        <Label Text="Item 1" FontSize="Large" TextColor="#212121"/>
                    </Frame>
                </toolkit:Expander.Header>
                <toolkit:Expander.Content>
                    <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" BackgroundColor="White">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="This is the detailed description of item 1." TextColor="#757575"/>
                            <Button Text="Action Button 1" BackgroundColor="#2196F3" TextColor="White"/>
                        </VerticalStackLayout>
                    </Frame>
                </toolkit:Expander.Content>
            </toolkit:Expander>

            <!-- Expanding Block 2 -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Frame BorderColor="#BDBDBD" CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="White">
                        <Label Text="Item 2" FontSize="Large" TextColor="#212121"/>
                    </Frame>
                </toolkit:Expander.Header>
                <toolkit:Expander.Content>
                    <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" BackgroundColor="White">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="This is the detailed description of item 2." TextColor="#757575"/>
                            <Button Text="Action Button 2" BackgroundColor="#2196F3" TextColor="White"/>
                        </VerticalStackLayout>
                    </Frame>
                </toolkit:Expander.Content>
            </toolkit:Expander>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>