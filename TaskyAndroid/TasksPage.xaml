<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TaskyAndroid.Convertors"
             x:Class="TaskyAndroid.TasksPage"
             Title="TasksPage">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8036" Offset="0.1"/>
            <GradientStop Color="#e67d40" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:UsernameAndTypeConvert x:Key="UserConvert"/>
            <local:CategoryConvert x:Key="CategoryConvert"/>
        </ResourceDictionary>
        <Color x:Key="PrimaryColor">#FF5722</Color>
        <Color x:Key="SecondaryColor">#FBE9E7</Color>
        <Color x:Key="AccentColor">#FF8A65</Color>
        <Color x:Key="TaskCardBackground">#FFFFFF</Color>
        <Color x:Key="TaskCardBorder">#EEEEEE</Color>
        <Color x:Key="TaskDescriptionColor">#424242</Color>
        <Color x:Key="CategoryTagColor">#FF9800</Color>
        <Color x:Key="CategoryTagTextColor">#FFFFFF</Color>
        <Color x:Key="StatusIndicatorColor">#FF9500</Color>
        <Color x:Key="SubmitButtonColor">#FF9500</Color>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontFamily" Value="OpenSansRegular"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black"
                            Offset="0,2"
                            Radius="4"
                            Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray600}}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black"
                            Offset="0,2"
                            Radius="6"
                            Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataTextStyle" TargetType="Label">
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="OpenSansRegular"/>
        </Style>

        <Style x:Key="UserInfoLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular"/>
            <Setter Property="TextColor" Value="{StaticResource Gray600}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="TaskSubjectStyle" TargetType="Label">
            <Setter Property="FontSize" Value="Large"/>
            <Setter Property="FontFamily" Value="OpenSansSemiBold"/>
            <Setter Property="TextColor" Value="#212121"/>
            <Setter Property="LineBreakMode" Value="TailTruncation"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>

        <Style x:Key="TaskDescriptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="Small"/>
            <Setter Property="TextColor" Value="{StaticResource TaskDescriptionColor}"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="LineBreakMode" Value="WordWrap"/>
        </Style>

        <Style x:Key="CategoryTagStyle" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{StaticResource CategoryTagColor}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HasShadow" Value="False"/>
            <Setter Property="HorizontalOptions" Value="Start"/>
        </Style>

        <Style x:Key="CategoryTextStyle" TargetType="Label">
            <Setter Property="TextColor" Value="blue"/>
            <Setter Property="FontSize" Value="Small"/>
            <Setter Property="FontFamily" Value="OpenSansSemi"/>
        </Style>

        <Style x:Key="SubmitButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource SubmitButtonColor}"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="FontFamily" Value="OpenSansSemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalOptions" Value="End"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource StatusIndicatorColor}"/>
            <Setter Property="WidthRequest" Value="15"/>
            <Setter Property="HeightRequest" Value="15"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="HorizontalOptions" Value="Start"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="20"
          x:Name="MainGrid">

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,20">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  RowSpacing="0">

                <!-- Logo -->
                <HorizontalStackLayout Grid.Column="0"
                                      Spacing="8">
                    <Image Source="taskylogo.png"
                           HeightRequest="50"
                           WidthRequest="70"/>
                </HorizontalStackLayout>

                <!-- My Shifts Button -->
                <Button Grid.Column="1"
                        Text="My Shifts"
                        Style="{StaticResource HeaderButtonStyle}"
                        BackgroundColor="{StaticResource SecondaryColor}"
                        TextColor="{StaticResource PrimaryColor}"
                        FontFamily="OpenSansSemiBold"
                        Margin="10,0"/>

                <!-- Logout Button -->
                <Button Grid.Column="2"
                        Text="Logout"
                        Style="{StaticResource HeaderButtonStyle}"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"/>
            </Grid>
        </Border>

        <!-- User Info Card -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,20"
                x:Name="UserInfoBorder">
            <Grid ColumnDefinitions="Auto,*">
                <!-- User Details -->
                <VerticalStackLayout Grid.Column="1"
                                    VerticalOptions="Center">
                    <Label Text="{Binding .,Converter={StaticResource UserConvert}}"
                           FontFamily="OpenSansRegular"
                           FontSize="20"
                           TextColor="{StaticResource PrimaryColor}"/>
                    <Label Text="{Binding email}"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           TextColor="{StaticResource PrimaryColor}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}" 
                x:Name="TaskBoard">
            <ScrollView>
                <VerticalStackLayout Padding="10" Spacing="15">
                    <Label Text="My Tasks" 
                           FontSize="24" 
                           TextColor="#212121" 
                           FontFamily="OpenSansBold" 
                           Margin="5,0,0,10"/>

                    <CollectionView SelectionMode="None" x:Name="TaskList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <toolkit:Expander Margin="0,0,0,15">
                                    <toolkit:Expander.Header>
                                        <Frame BorderColor="{StaticResource TaskCardBorder}" 
                                               CornerRadius="12" 
                                               Padding="15" 
                                               HasShadow="True" 
                                               BackgroundColor="{StaticResource TaskCardBackground}">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Ellipse Style="{StaticResource StatusIndicatorStyle}" 
                                                         Grid.Column="0"/>

                                                <Label Text="{Binding subject}" 
                                                       Style="{StaticResource TaskSubjectStyle}"
                                                       Grid.Column="1"/>
                                            </Grid>
                                        </Frame>
                                    </toolkit:Expander.Header>
                                    <toolkit:Expander.Content>
                                        <Frame BorderColor="{StaticResource TaskCardBorder}" 
                                               CornerRadius="12" 
                                               Padding="20" 
                                               BackgroundColor="#FAFAFA"
                                               Margin="5,0,5,5">
                                            <VerticalStackLayout Spacing="12">
                                                <Frame Style="{StaticResource CategoryTagStyle}">
                                                    <Label Text="{Binding ., Converter={StaticResource CategoryConvert}}" 
                                                          Style="{StaticResource CategoryTextStyle}"/>
                                                </Frame>

                                                <BoxView HeightRequest="1" 
                                                         BackgroundColor="#EEEEEE"
                                                         Margin="0,5"/>

                                                <Label Text="{Binding description}" 
                                                       Style="{StaticResource TaskDescriptionStyle}"/>

                                                <Button Text="Submit Task" 
                                                        Style="{StaticResource SubmitButtonStyle}">
                                                    <Button.Shadow>
                                                        <Shadow Brush="#40000000"
                                                                Offset="0,3"
                                                                Radius="5" />
                                                    </Button.Shadow>
                                                </Button>
                                            </VerticalStackLayout>
                                        </Frame>
                                    </toolkit:Expander.Content>
                                </toolkit:Expander>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="No tasks available" 
                                       FontSize="18" 
                                       TextColor="#757575" 
                                       HorizontalOptions="Center"/>
                                <Label Text="All caught up!" 
                                       FontSize="14" 
                                       TextColor="#9E9E9E" 
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>