<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskyAndroid.LobbyPage"
             Title="LobbyPage">
    <ContentPage.Resources>
        <Color x:Key="PrimaryColor">#FF5722</Color>
        <Color x:Key="SecondaryColor">#FBE9E7</Color>
        <Color x:Key="AccentColor">#FF8A65</Color>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontFamily" Value="OpenSansRegular"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black"
                            Offset="0,2"
                            Radius="4"
                            Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray600}}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black"
                            Offset="0,2"
                            Radius="6"
                            Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataTextStyle" TargetType="Label">
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="OpenSansRegular"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"
          Padding="20"
          x:Name="MainGrid">

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,20">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  RowSpacing="0">

                <!-- Logo -->
                <HorizontalStackLayout Grid.Column="0"
                                      Spacing="8">
                    <Image Source="taskylogo.png"
                           HeightRequest="50"
                           WidthRequest="70"/>
                </HorizontalStackLayout>

                <!-- My Shifts Button -->
                <Button Grid.Column="1"
                        Text="My Shifts"
                        Style="{StaticResource HeaderButtonStyle}"
                        BackgroundColor="{StaticResource SecondaryColor}"
                        TextColor="{StaticResource PrimaryColor}"
                        FontFamily="OpenSansSemiBold"
                        Margin="10,0"/>

                <!-- Logout Button -->
                <Button Grid.Column="2"
                        Text="Logout"
                        Style="{StaticResource HeaderButtonStyle}"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="24">

                <!-- Shift Info Card -->
                <Border Style="{StaticResource CardStyle}"
                        BackgroundColor="{StaticResource SecondaryColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Current Shift"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               FontFamily="OpenSansRegular"/>
                        <Label Text="Morning Shift"
                               HorizontalTextAlignment="Center"
                               FontSize="20"
                               TextColor="{StaticResource Gray900}"
                               FontFamily="OpenSansSemiBold"/>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="12/2/2025 8:00" Style="{StaticResource DataTextStyle}"/>
                            <Label Text="-" Style="{StaticResource DataTextStyle}"/>
                            <Label Text="13/2/2025 8:00" Style="{StaticResource DataTextStyle}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Clock-In Button -->
                <Frame CornerRadius="100"
                       HasShadow="True"
                       BorderColor="Transparent"
                       HeightRequest="200"
                       WidthRequest="200"
                       Padding="0"
                       HorizontalOptions="Center"
                       BackgroundColor="{StaticResource PrimaryColor}">
                    <Button Text="Clock-In"
                            FontSize="24"
                            FontFamily="OpenSansBold"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            CornerRadius="100"
                            HeightRequest="200"
                            WidthRequest="200"/>
                </Frame>

                <!-- Info Text -->
                <Border Style="{StaticResource CardStyle}"
                        BackgroundColor="{StaticResource SecondaryColor}">
                    <Label Text="After pressing the button, a shift-manager or an admin will have to approve your clock-in. Only then your clock will start."
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           HorizontalTextAlignment="Center"/>
                </Border>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>