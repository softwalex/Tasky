<Page x:Class="TaskClientPC.UpdateWindows.UpdateUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaskClientPC.UpdateWindows" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UpdateUserPage">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <TextBlock Grid.Row="0" 
                   Text="Update User Profile" 
                   FontSize="24" 
                   FontWeight="Medium" 
                   Margin="0,0,0,16" 
                   Foreground="#333333"/>

        <!-- Main Content Card -->
        <materialDesign:Card Grid.Row="1" 
                              Padding="16" 
                              UniformCornerRadius="8" 
                              Background="White" 
                              materialDesign:ShadowAssist.ShadowDepth="Depth2">
            <ScrollViewer>
                <StackPanel>
                    <!-- Name Fields in One Line -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                 Text="First Name" 
                                 Margin="0,0,8,0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="First Name"
                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible"/>
                        <TextBox Grid.Column="1" 
                                 Text="Last Name" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Last Name"
                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible"/>
                    </Grid>

                    <!-- Email Field -->
                    <TextBox Text="Email Address" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Email Address"
                             Margin="0,8"
                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible"/>

                    <!-- Birthday Picker -->
                    <DatePicker Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                materialDesign:HintAssist.Hint="Birthday"
                                Margin="0,8"/>

                    <!-- Role Selection -->
                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="User Role"
                              Margin="0,8">
                        <ComboBoxItem>Admin</ComboBoxItem>
                        <ComboBoxItem>ShiftManager</ComboBoxItem>
                        <ComboBoxItem>Worker</ComboBoxItem>
                    </ComboBox>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Margin="0,16,0,0">
                        <Button Content="Cancel" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="Update Profile" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#2196F3"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</Page>
