<Window x:Class="TaskClientPC.UpdateWindows.UpdateShift"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskClientPC.UpdateWindows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="UpdateShift" Height="430" Width="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="1" 
                        Padding="16" 
                        UniformCornerRadius="8" 
                        Background="White">
            <ScrollViewer>
                <StackPanel>
                    <TextBox x:Name="ShiftNameBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Shift Name"
                         Margin="0,8"
                             Text="{Binding shiftName}"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible">
                    </TextBox>

                    <!-- Start Time Section -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Start Time Controls -->
                        <StackPanel Grid.Column="0">
                            <DatePicker x:Name="StartTime"
                                  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                  materialDesign:HintAssist.Hint="Start Date"
                                  Margin="0,8,4,8"
                                  SelectedDate="{Binding start,Mode=OneWay}"
                                  SelectedDateChanged="StartTime_SelectedDateChanged"/>

                            <materialDesign:TimePicker
                            x:Name="StartTimePicker"
                            Style="{StaticResource MaterialDesignOutlinedTimePicker}"
                            materialDesign:HintAssist.Hint="Start Time"
                            Is24Hours="True"
                            Margin="0,0,4,8"
                            Visibility="Collapsed"
                            SelectedTime="{Binding start, Mode=OneWay}"/>
                        </StackPanel>

                        <!-- End Time Controls -->
                        <StackPanel Grid.Column="1">
                            <DatePicker x:Name="EndTime"
                                  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                  materialDesign:HintAssist.Hint="End Date"
                                  Margin="4,8,0,8"
                                  SelectedDate="{Binding end,Mode=OneWay}"
                                  SelectedDateChanged="EndTime_SelectedDateChanged"/>

                            <materialDesign:TimePicker
                            x:Name="EndTimePicker"
                            Style="{StaticResource MaterialDesignOutlinedTimePicker}"
                            materialDesign:HintAssist.Hint="End Time"
                            Is24Hours="True"
                            Margin="4,0,0,8"
                            Visibility="Collapsed"
                            SelectedTime="{Binding end, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="ErorText" Text="" FontSize="15" Foreground="Red"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" 
                          HorizontalAlignment="Right"
                          Margin="0,16,0,0">
                        <Button Content="Cancel" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"
                            Click="CloseUpdateWindow"/>
                        <Button Content="Update Shift"
                            x:Name="SubmitButton"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#f39c12"
                            Click="UpdateShiftButton"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</Window>