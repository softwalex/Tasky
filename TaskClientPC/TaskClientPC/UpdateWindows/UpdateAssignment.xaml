<Window x:Class="TaskClientPC.UpdateWindows.UpdateAssignment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskClientPC.UpdateWindows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:convert="clr-namespace:TaskClientPC.Covertors"
        mc:Ignorable="d"
        Title="UpdateAssignment" Height="450" Width="800">
    <Window.Resources>
        <convert:ConvertCategory x:Key="CovertCategory"/>
        <convert:ConvertShift x:Key="ConvertShift"/>
        <convert:ConvertUser x:Key="ConvertUser"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main Content Card -->
        <materialDesign:Card Grid.Row="1" 
                            Padding="16" 
                            UniformCornerRadius="8" 
                            Background="White">
            <ScrollViewer>
                <StackPanel>
                    <!-- TextBox and ComboBox in One Line -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SubjectBox"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                materialDesign:HintAssist.Hint="Enter Subject"
                                materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible"/>

                        <ComboBox x:Name="CategoryComboBox"
                                 Grid.Column="1"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 materialDesign:HintAssist.Hint="Select Category">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., Converter={StaticResource CovertCategory}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Large Description TextBox -->
                    <TextBox x:Name="DescriptionBox"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            materialDesign:HintAssist.Hint="Description"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MinHeight="100"
                            Margin="0,0,0,16"/>

                    <!-- Two ComboBoxes with Text -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="for" 
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>

                        <ComboBox x:Name="UserComboBox"
                                 Grid.Column="1"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 materialDesign:HintAssist.Hint="Select User"
                                 Margin="0,0,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., Converter={StaticResource ConvertUser}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="in" 
                                 Grid.Column="2"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>

                        <ComboBox x:Name="ShiftComboBox"
                                 Grid.Column="3"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 materialDesign:HintAssist.Hint="Select Shift">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., Converter={StaticResource ConvertShift}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Error Text -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="ErrorText" Text="" FontSize="15" Foreground="Red"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" 
                              HorizontalAlignment="Right"
                              Margin="0,16,0,0">
                        <Button Content="Cancel" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0"
                                Click="CloseUpdateWindow"/>
                        <Button Content="Update Assignment"
                                x:Name="SubmitButton"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#f39c12"
                                Click="UpdateAssignmentButton"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</Window>
