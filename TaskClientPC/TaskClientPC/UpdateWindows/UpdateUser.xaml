<Window x:Class="TaskClientPC.UpdateWindows.UpdateUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskClientPC.UpdateWindows"
        xmlns:valid="clr-namespace:TaskClientPC.Validations"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="UpdateUser" Height="500" Width="800">
    <Window.Resources>
        <Style TargetType="TextBox">
                        <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <AdornedElementPlaceholder x:Name="Placeholder"/>
                            <TextBlock FontSize="10"
                               FontStyle="Italic"
                               Foreground="red"
                               Text="{Binding [0].ErrorContent}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
             Value="{Binding RelativeSource={x:Static RelativeSource.Self},
             Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>    
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main Content Card -->
        <materialDesign:Card Grid.Row="1" 
                              Padding="16" 
                              UniformCornerRadius="8" 
                              Background="White" 
                              >
            <ScrollViewer>
                <StackPanel>
                    <!-- Name Fields in One Line -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FirstNameBox"
                                 Grid.Column="0"  
                                 Margin="0,0,8,0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="First Name"
                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible">
                            <TextBox.Text>
                                <Binding Path="firstname" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <valid:ValidFirstName/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <TextBox x:Name="LastNameBox"
                                 Grid.Column="1"  
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Last Name"
                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible">
                            <TextBox.Text>
                                <Binding Path="lastname" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <valid:ValidLastName/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </Grid>

                    <!-- Email Field -->
                    <TextBox x:Name="EmailBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Email Address"
                             Margin="0,8"
                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible">
                        <TextBox.Text>
                            <Binding Path="email" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                <Binding.ValidationRules>
                                    <valid:ValidLastName/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <!-- Birthday Picker -->
                    <DatePicker x:Name="BirthdayBox"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                materialDesign:HintAssist.Hint="Birthday"
                                Margin="0,8">
                        <DatePicker.SelectedDate>
                            <Binding Path="birthday" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                <Binding.ValidationRules>
                                    <valid:ValidDate/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DatePicker.SelectedDate>
                    </DatePicker>

                    <!-- Role Selection -->
                    <ComboBox x:Name="UserTypeBox"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="User Type"
                              Margin="0,8">
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="ErorText" Text="" FontSize="15" Foreground="Red"/>
                    </StackPanel>
                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Content="Cancel" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0"
                                Click="CloseUpdateWindow"/>
                        <Button Content="Update Profile" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#f39c12"
                                Click="UpdateUserButton"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</Window>
