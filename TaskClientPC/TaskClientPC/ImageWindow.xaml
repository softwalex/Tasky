<Window x:Class="TaskClientPC.ImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskClientPC"
        xmlns:convert="clr-namespace:TaskClientPC.Covertors"
        mc:Ignorable="d"
        Title="ImageWindow" Height="450" Width="800">
    <Window.Resources>
        <convert:ImageConvertor x:Key="ConvertImage"/>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Image x:Name="imgUser" Stretch="Fill" Source="{Binding image, 
      						  Converter={StaticResource ConvertImage}}"/>
    </Grid>
</Window>
