<Window x:Class="TaskClientPC.ResetPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskClientPC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="ResetPassword" Height="650" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PasswordBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <!-- Background Gradient -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFE5A323" Offset="0.0"/>
                    <GradientStop Color="#FFFF7043" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Main Content Grid -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Right Side - Login Form -->
            <Border Grid.Column="1" 
                   Background="White" 
                   CornerRadius="8" 
                   Margin="20" 
                   Padding="30">
                <StackPanel>
                    <!-- Header with Logo and LOGIN text -->
                    <StackPanel Orientation="Horizontal" 
                             Margin="0,0,0,30">
                        <Border Background="#FF7043" 
                               CornerRadius="4">
                            <Button Click="LinkToLoginWindow" Height="63">
                                <Button.Content>
                                    <Image Source="images/TaskyLogo.png" 
                                      Width="70" 
                                      Height="63"/>
                                </Button.Content>
                            </Button>
                        </Border>
                        <TextBlock Text="Reset Password" 
                                FontSize="24" 
                                FontWeight="Bold" 
                                Foreground="#FF7043"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Text="" Foreground="Red" HorizontalAlignment="Center"></TextBlock>
                    <TextBlock Text="A code was sent to your email adress" HorizontalAlignment="Center"/>
                    <!-- Email Field -->
                    <Label Content="Code:"/>
                    <TextBox x:Name="CodeTextBox"
                           Height="40"
                           Margin="0,0,0,20"
                           BorderThickness="1"
                           BorderBrush="#E0E0E0"
                           Padding="10"/>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock>Password length must be between 5 to 15</TextBlock>
                        <TextBlock>Password must have a capital letter in it</TextBlock>
                        <TextBlock>Password must contain numbers</TextBlock>
                        <TextBlock>Password must contain symbols</TextBlock>
                    </StackPanel>
                    <!-- Password Field -->
                    <Label Content="Password:"/>
                    <PasswordBox x:Name="PassBox"
                            Height="40"
                             Margin="0,0,0,20"
                             BorderThickness="1"
                             BorderBrush="#E0E0E0"
                             Padding="10" />

                    <Label Content="Repeat Password:"/>
                    <PasswordBox x:Name="RePassBox"
                            Height="40"
                             Margin="0,0,0,20"
                             BorderThickness="1"
                             BorderBrush="#E0E0E0"
                             Padding="10" />

                    <!-- Login Button -->
                    <Button Content="RESET PASSWORD"
                           Height="40"
                           Background="#FF7043"
                           Foreground="White"
                           BorderThickness="0"
                           Margin="0,0,0,20"
                           Click="ResetPasswordButtonClick"/>

                    <!-- Sign Up Link -->
                    <StackPanel Orientation="Horizontal" 
                             HorizontalAlignment="Center">
                        <TextBlock Text="Press on the logo to return to login page"
                                Foreground="#666666"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
