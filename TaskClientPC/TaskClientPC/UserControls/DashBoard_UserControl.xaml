<UserControl x:Class="TaskClientPC.UserControls.DashBoard_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskClientPC.UserControls"
             xmlns:convert="clr-namespace:TaskClientPC.Covertors"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="700" Width="900"
             Background="#FFA500"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             FontFamily="{materialDesign:MaterialDesignFont}">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp3"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <convert:ConvertCategory x:Key="ConvertCategory"/>
        <convert:ConvertShift x:Key="ConvertShift"/>
        <convert:ConvertUser x:Key="ConvertUser"/>
        <convert:ConvertUser x:Key="ConvertTimeShift"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="23.808"/>
            <ColumnDefinition Width="236.192"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10,0,135,491">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Shift Header Card -->
            <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Row="0">
                <StackPanel x:Name="CurrentShift">
                    <TextBlock Text="{Binding shiftName}" 
                             x:Name="CurrentShiftNameBlock"
                             FontSize="24" 
                             Foreground="#FF5722"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding start, StringFormat=dd/MM/yyyy HH:mm}" 
                             FontSize="18"
                             Foreground="#FF5722"
                             HorizontalAlignment="Center"
                             Margin="0,5,0,0"/>   
                        <TextBlock Text=" - " 
                             FontSize="18"
                             Foreground="#FF5722"
                             HorizontalAlignment="Center"
                             Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding end, StringFormat=dd/MM/yyyy HH:mm}" 
                             FontSize="18"
                             Foreground="#FF5722"
                             HorizontalAlignment="Center"
                             Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Staff Icons Card -->
            <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Row="1" Margin="10,10,10,-359">
                <DockPanel>
                    <TextBlock Text="Users In Current Shift" 
                         Foreground="#FF5722"
                         FontSize="20"
                         FontWeight="Bold"
                         Margin="0,0,0,10"
                         DockPanel.Dock="Top"/>
                    <ListView x:Name="usersListView"
                    Grid.Row="1" Grid.Column="0"
                    SelectionChanged="usersListView_SelectionChanged" 
                    ScrollViewer.CanContentScroll="True" 
                    FontSize="10" 
                    HorizontalAlignment="Left" 
                    Width="400"
                    BorderThickness="0">
                        <!-- Existing ListView content -->
                        <ListView.View>
                            <GridView ScrollViewer.HorizontalScrollBarVisibility="Visible">
                                <GridViewColumn Header="Name" Width="250">
                                    <GridViewColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Name" 
                                             FontWeight="Bold" 
                                             FontSize="16" 
                                             Foreground="#FF5722"/>
                                        </DataTemplate>
                                    </GridViewColumn.HeaderTemplate>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding _user}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#424242" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFE0B2"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF3E0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
        <!-- Tasks Card -->
        <materialDesign:Card Style="{StaticResource CardStyle}" 
                           MinWidth="250"
                           MaxWidth="700" 
                           HorizontalAlignment="Left" 
                           Margin="485,10,0,130" 
                           Width="365" 
                           Grid.ColumnSpan="3">
            <DockPanel>
                <TextBlock Text="Tasks For Current Shift" 
                         Foreground="#FF5722"
                         FontSize="20"
                         FontWeight="Bold"
                         Margin="0,0,0,10"
                         DockPanel.Dock="Top"/>
                <ListView x:Name="AssignmentsListView"
                          Grid.Row="1" Grid.Column="0"
                          SelectionChanged="AssignmentsListView_SelectionChanged"
                          ScrollViewer.CanContentScroll="True"
                          FontSize="10"
                          HorizontalAlignment="Left"
                          Width="540"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView ScrollViewer.HorizontalScrollBarVisibility="Visible">
                            <GridViewColumn Header="Subject" Width="200">
                                <GridViewColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="subject" 
                                                FontWeight="Bold"
                                                FontSize="16" 
                                                Foreground="#FF5722">
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.HeaderTemplate>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding subject}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Date" Width="120">
                                <GridViewColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="For User"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#FF5722"/>
                                    </DataTemplate>
                                </GridViewColumn.HeaderTemplate>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding forUser, Converter={StaticResource ConvertUser}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Padding" Value="10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#424242" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFE0B2"/>
                                    <Setter Property="Foreground" Value="#E65100"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF3E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>