<UserControl x:Class="TaskClientPC.UserControls.Assignments_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskClientPC.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:convert="clr-namespace:TaskClientPC.Covertors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <convert:ConvertCategory x:Key="ConvertCategory"/>
        <convert:ConvertShift x:Key="ConvertShift"/>
        <convert:ConvertUser x:Key="ConvertUser"/>
    </UserControl.Resources>
    <Grid Margin="0,20,0,0" RenderTransformOrigin="0.59,0.471">
        <!-- Background Gradient with Orange Colors -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF9800" Offset="0.0"/>
                <GradientStop Color="#F57C00" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.Resources>
            <!-- Material Shadow Effect -->
            <DropShadowEffect x:Key="MaterialShadow" 
                         BlurRadius="10" 
                         Direction="270" 
                         ShadowDepth="3" 
                         Opacity="0.3"/>

            <!-- TextBlock Styles -->
            <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="20,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#FF5722"/>
            </Style>

            <Style x:Key="DetailValueStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="20,10"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="#424242"/>
            </Style>

            <Style x:Key="FlipCardStyle" TargetType="Grid">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="0"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Flipped">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation 
                           Storyboard.TargetProperty="(Grid.RenderTransform).(RotateTransform.Angle)"
                           From="0" To="360" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation 
                           Storyboard.TargetProperty="(Grid.RenderTransform).(RotateTransform.Angle)"
                           From="360" To="0" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" 
           Background="White" 
           CornerRadius="12" 
           Margin="20,20,-70,20" 
           Padding="15"
           Effect="{StaticResource MaterialShadow}">
            <Grid>
                <Grid x:Name="FrontCard" Style="{StaticResource FlipCardStyle}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <TextBlock Text="Assignments List" 
                                     DockPanel.Dock="Left" 
                                     FontSize="24" 
                                     FontWeight="Bold" 
                                     Margin="10,0,0,15"
                                     Foreground="#FF5722"/>

                            <Button x:Name="AddNewAssignmentButton"
                                   Click="AddAssignment"
                                   DockPanel.Dock="Right"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Height="36"
                                   Width="120"
                                   Margin="0,0,10,15"
                                   Background="#FB8C00"
                                   BorderThickness="0"
                                   materialDesign:ButtonAssist.CornerRadius="18">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" 
                                              Height="20" 
                                              Width="20" 
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <TextBlock Text="Add New" 
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="FlipButton"
                            Click="FlipCard_Click"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="36"
                            Width="120"
                            Margin="0,0,10,15"
                            Background="#FB8C00"
                            BorderThickness="0"
                            materialDesign:ButtonAssist.CornerRadius="18">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Filter Options" 
                                       VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <TextBox DockPanel.Dock="Top"
                               x:Name="SearchBox"
                               TextChanged="SearchBox_TextChanged"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Margin="10,0,10,20"
                               Height="50"
                               materialDesign:HintAssist.Hint="Search shifts by name..."
                               materialDesign:TextFieldAssist.HasClearButton="True">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <ListView x:Name="AssignmentsListView"
                           Grid.Row="1" Grid.Column="0"
                           SelectionChanged="AssignmentsListView_SelectionChanged" 
                           ScrollViewer.CanContentScroll="True" 
                           FontSize="10" 
                           HorizontalAlignment="Left" 
                           Width="540"
                           BorderThickness="0">
                            <ListView.View>
                                <GridView ScrollViewer.HorizontalScrollBarVisibility="Visible">
                                    <GridViewColumn Header="Subject" Width="300">
                                        <GridViewColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="Subject" 
                                                    FontWeight="Bold" 
                                                    FontSize="16" 
                                                    Foreground="#FF5722"/>
                                            </DataTemplate>
                                        </GridViewColumn.HeaderTemplate>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding subject}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Date" Width="Auto">
                                        <GridViewColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="Date" 
                                                    FontWeight="Bold" 
                                                    FontSize="16" 
                                                    Foreground="#FF5722"/>
                                            </DataTemplate>
                                        </GridViewColumn.HeaderTemplate>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding dateOfAssigment, StringFormat=dd/MM/yyyy HH:mm}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Padding" Value="10" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#424242" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFE0B2"/>
                                            <Setter Property="Foreground" Value="#E65100"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </DockPanel>
                </Grid>

                <Grid x:Name="BackCard" Style="{StaticResource FlipCardStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Vertical" Margin="20" x:Name="FilterStackPanle">
                        <StackPanel Margin="0,0,0,30" Orientation="Horizontal">
                            <TextBlock Text="Filters" 
                                  FontSize="24" 
                                  FontWeight="Bold" 
                                  Foreground="#FF5722"
                                  Margin="0,0,30,0"/>
                            <TextBlock HorizontalAlignment="Center" Foreground="#FF5722" Margin="0,10,0,0" Text="You can leave fields that are not essential to be empty"></TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,30">
                            <TextBox x:Name="FilterSubjectTextBox" 
                                     Width="300"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Visible"
                                     materialDesign:HintAssist.Hint="Enter Subject"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,30">
                            <ComboBox x:Name="FilterCategoryComboBox"
                                 Grid.Column="1"
                                      Width="300"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 materialDesign:HintAssist.Hint="Select Category">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={StaticResource ConvertCategory}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,30">
                            <TextBox x:Name="FilterDescriptionTextBox"
                                     Width="300"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    materialDesign:HintAssist.Hint="Description"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    MinHeight="100"
                                    Margin="0,0,0,16"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,30">
                            <ComboBox x:Name="FilterForUserComboBox"
                                 Grid.Column="1"
                                 Width="300"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 materialDesign:HintAssist.Hint="For User">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={StaticResource ConvertUser}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,30">
                            <ComboBox x:Name="FilterForShiftComboBox"
                                      Grid.Column="1"
                                      Width="300"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="For Shift">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={StaticResource ConvertShift}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="Apply Filters"
                                   Click="FlipCard_Click"
                                   Width="150" 
                                   Margin="0,0,10,0"
                                   Background="#FB8C00"
                                   Foreground="White"/>
                            <Button Content="Show All Assignments"
                                   Click="FlipCard_Click"
                                   Width="150" 
                                   Background="#FF5722"
                                   Foreground="White"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                x:Name="DataBorder"
                Visibility="Collapsed"
                Background="White"
                CornerRadius="12"
                Margin="110,68,10,108"
                Padding="20"
                Effect="{StaticResource MaterialShadow}">
            <Grid x:Name="DataGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="13*"/>
                    <ColumnDefinition Width="67*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" Grid.ColumnSpan="3">
                    <DockPanel>
                        <TextBlock Text="Assignment Details" 
                             FontSize="24" 
                             FontWeight="Bold" 
                             Foreground="#FF5722"
                             DockPanel.Dock="Left"
                             Margin="20,0,0,20"/>
                        <Button x:Name="DeleteButton" 
                              Grid.ColumnSpan="3" 
                              Click="DeleteAssignment" 
                              Background="#FF5722" 
                              Content="DELETE" 
                              Height="36" 
                              Width="100" 
                              HorizontalAlignment="Right"
                              Margin="0,0,20,0"
                              Foreground="White"
                              BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="ImageButton" 
                              Grid.ColumnSpan="3" 
                              Click="ViewImage" 
                              Background="#FF5722" 
                              Content="Image" 
                              Height="36" 
                              Width="100" 
                              HorizontalAlignment="Right"
                              Margin="0,0,20,0"
                              Foreground="White"
                              BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                    <Border Background="#FBE9E7"
                            CornerRadius="8"
                            Margin="10"
                            Padding="10">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" x:Name="SubjectSP">
                                <TextBlock Text="Subject: " Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding subject}" x:Name="SubjectBlock" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#FFE0B2" Margin="20,0"/>
                            <StackPanel Orientation="Horizontal" x:Name="CategorySP">
                                <TextBlock Text="Category: " Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding _category, Converter={StaticResource ConvertCategory}}" x:Name="CategoryBlock" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#FFE0B2" Margin="20,0"/>
                            <StackPanel Orientation="Horizontal" x:Name="DescriptionSP">
                                <TextBlock Text="Description: " Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding description}" x:Name="DescriptionBlock" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#FFE0B2" Margin="20,0"/>
                            <StackPanel Orientation="Horizontal" x:Name="DateOfAssignmentSP">
                                <TextBlock Text="Date: " Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding dateOfAssigment, StringFormat=dd/MM/yyyy HH:mm}" x:Name="DateOfAssignmentBlock" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#FFE0B2" Margin="20,0"/>
                            <StackPanel Orientation="Horizontal" x:Name="ForShiftSP">
                                <TextBlock Text="For Shift: " Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding forShift, Converter={StaticResource ConvertShift}}" x:Name="ForShiftBlock" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#FFE0B2" Margin="20,0"/>
                            <StackPanel Orientation="Horizontal" x:Name="ForUserSP">
                                <TextBlock Text="For User: " Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding forUser, Converter={StaticResource ConvertUser}}" x:Name="ForUserBlock" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#FFE0B2" Margin="20,0"/>
                            <StackPanel Orientation="Horizontal" x:Name="DoneByUserSP">
                                <TextBlock Text="Done By User: " Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding doneByUser, Converter={StaticResource ConvertUser}}" x:Name="DoneByUserBlock" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#FFE0B2" Margin="20,0"/>
                            <StackPanel Orientation="Horizontal" x:Name="SummerySP">
                                <TextBlock Text="Summery: " Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding summery}" x:Name="SummeryBlock" Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="UpdateButton"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}"
                        Height="50"
                        Width="200"
                        Content="UPDATE"
                        Click="UpdateAssignment"
                        Background="#FB8C00"
                        materialDesign:ButtonAssist.CornerRadius="25"
                        Margin="20,20,0,0"
                        Foreground="White"
                        BorderThickness="0"
                        ToolTip="Update Assignment information">
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
