<UserControl x:Class="TaskClientPC.UserControls.Users_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskClientPC.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0,20,0,0">
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE5A323" Offset="0.0"/>
                <GradientStop Color="#FFFF7043" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                Background="White" 
                CornerRadius="8" 
                Margin="20" 
                Padding="10">
            <ListView x:Name="usersListView"
                  Grid.Row="1" Grid.Column="0"
                  SelectionChanged="usersListView_SelectionChanged" 
                  ScrollViewer.CanContentScroll="True" FontSize="10">
                <ListView.View>
                    <GridView ScrollViewer.HorizontalScrollBarVisibility="Visible">
                        <GridViewColumn Header="Name" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding firstname}" Margin="5,0,0,0"/>
                                        <TextBlock Text="{Binding lastname}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Type" Width="Auto" DisplayMemberBinding="{Binding userType}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="FontSize" Value="20" />
                        <Setter Property="Foreground" Value="Blue" />
                        <Setter Property="Margin" Value="5" />
                    </Style>
                </ListView.ItemContainerStyle>
                <!--<ListView.ItemTemplate>
    <DataTemplate>
        <Border CornerRadius="8" BorderThickness="2" Width="220" BorderBrush="Red">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding firstname}"/>
                <TextBlock Text="{Binding lastname}"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ListView.ItemTemplate>-->
            </ListView>
        </Border>

        <!-- Right Side - Login Form -->
        <Border Grid.Column="1" 
                Background="White" 
                CornerRadius="8" 
                Margin="80" 
                Padding="10">
            <Grid x:Name="DataGrid">
                
            </Grid>
        </Border>
    </Grid>
</UserControl>
